layout {
    focus-ring {
        width 2
        active-color "#00696c"
        inactive-color "transparent"
        urgent-color "#ba1a1a"
    }
    shadow {
        on
        softness 28
        spread 6
        offset x=0 y=0
        draw-behind-window false
        color "#00696c95"
        inactive-color "#00000045"
    }
    tab-indicator {
        active-color "#00696c"
        inactive-color "#9cf1f3"
        urgent-color "#ba1a1a"
    }
    insert-hint {
        color "#00696c80"
    }
}

